<Window x:Class="Norevia_Startup_Manager_Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Norevia Startup Manager Lite"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B0F17"
        Foreground="#E6EAF2"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Subtle separators -->
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#243041"/>
        <SolidColorBrush x:Key="PanelBg" Color="#0F1521"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#0D1320"/>
        <SolidColorBrush x:Key="Accent" Color="#6EE7FF"/>
        <!-- Admin button -->
        <Style x:Key="AdminButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="Background" Value="#122033"/>
            <Setter Property="BorderBrush" Value="#3A5676"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" Margin="0,0,8,0" Opacity="0.95"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182B45"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="Background" Value="#121A2A"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18233A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="Background" Value="#0F1727"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="CaretBrush" Value="#E6EAF2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#3A5676"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- DataGrid base -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#B8C4D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#0F1727"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#141C2B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F1727"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#14213A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="Background" Value="#121A2A"/>
            <Setter Property="BorderBrush" Value="#2A3A52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <!-- DISABLE action (Status = Enabled) -> RED hover -->
                            <DataTrigger Binding="{Binding Model.Status}" Value="Enabled">
                                <Setter Property="Background" Value="#2A1212"/>
                                <Setter Property="BorderBrush" Value="#7A2A2A"/>
                                <Setter Property="Content" Value="Disable"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Model.Status}" Value="Enabled"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#401717"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5C5C"/>
                            </MultiDataTrigger>

                            <!-- ENABLE action (Status = Disabled) -> GREEN hover -->
                            <DataTrigger Binding="{Binding Model.Status}" Value="Disabled">
                                <Setter Property="Background" Value="#122A18"/>
                                <Setter Property="BorderBrush" Value="#2A7A42"/>
                                <Setter Property="Content" Value="Enable"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Model.Status}" Value="Disabled"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#174025"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#47FF8A"/>
                            </MultiDataTrigger>

                            <!-- Disabled command -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <!-- Controls -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- Admin banner -->
            <RowDefinition Height="6"/>
            <!-- Progress row -->
            <!-- Table -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
        Background="{StaticResource PanelBg}"
        BorderBrush="{StaticResource BorderBrushSoft}"
        BorderThickness="1"
        CornerRadius="16"
        Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Left -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right -->
                </Grid.ColumnDefinitions>

                <!-- LEFT: Title -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Norevia Startup Manager Lite" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Margin="0,6,0,0"
                       Opacity="0.85"
                       Text="This tool does not delete files. It only manages startup entries and creates a backup before any modification."/>
                </StackPanel>

                <!-- CENTER: Restart as Admin (only when NOT admin) -->
                <Button Grid.Column="1"
                Content="Restart as Administrator"
                Command="{Binding RestartAsAdminCommand}"
                Padding="18,10"
                Margin="40,0"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="#E6EAF2"/>
                            <Setter Property="Background" Value="#1E3A2E"/>
                            <Setter Property="BorderBrush" Value="#2F6F55"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🛡️" Margin="0,0,10,0"/>
                                                <ContentPresenter/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#245843"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#47FF8A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- RIGHT: Admin + Busy -->
                <Border Grid.Column="2"
                CornerRadius="12"
                Padding="10,8"
                BorderBrush="#2A3A52"
                BorderThickness="1"
                Background="#0F1727"
                VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Admin:" Margin="0,0,6,0" Opacity="0.85"/>

                        <TextBlock Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="No"/>
                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                            <Setter Property="Text" Value="Yes"/>
                                            <Setter Property="Foreground" Value="#47FF8A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="●" Margin="0,0,8,0" Foreground="{StaticResource Accent}"/>

                        <TextBlock Opacity="0.9">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Ready"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="Working..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- CONTROLS -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg2}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Refresh -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Search -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Export -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Clear -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Restart as Admin -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshCommand}"/>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F1727" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="10" Padding="10,8" Margin="0,0,10,0">
                        <TextBlock Text="🔎" FontSize="14" Opacity="0.85"/>
                    </Border>

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by name, publisher, path, location"/>
                </Grid>

                <Button Grid.Column="4" Content="Export CSV" Command="{Binding ExportCsvCommand}"/>
                <Button Grid.Column="6" Content="Clear" Padding="14,9"
        Command="{Binding ClearSearchCommand}" />
                              
            </Grid>
        </Border>
        <Border Grid.Row="3"
        Background="#101B2B"
        BorderBrush="#2A3A52"
        BorderThickness="1"
        CornerRadius="16"
        Padding="14"
        Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="Some actions require Administrator"/>
                    <TextBlock Opacity="0.85" Margin="0,4,0,0"
                       Text="To manage HKLM (All Users) startup entries, restart the app with elevated privileges."/>
                </StackPanel>

                <Button Grid.Column="1"
                Style="{StaticResource AdminButtonStyle}"
                Content="Restart as Admin"
                Command="{Binding RestartAsAdminCommand}"
                Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <!-- TABLE -->
        <Border Grid.Row="4" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16" Padding="10">
            <DataGrid ItemsSource="{Binding ItemsView}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="200"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="180"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>

                    <DataGridTemplateColumn Header="Action" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding ToggleCommand}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- FOOTER -->
        <Border Grid.Row="6" Background="{StaticResource PanelBg2}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Total:" Opacity="0.85"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalCount}" FontWeight="SemiBold"/>

                <TextBlock Grid.Column="4" Text="Enabled:" Opacity="0.85"/>
                <TextBlock Grid.Column="6" Text="{Binding EnabledCount}" FontWeight="SemiBold"/>

                <TextBlock Grid.Column="8" Text="{Binding StatusMessage}" Opacity="0.9"/>
            </Grid>
        </Border>
        <!-- BUSY / ERROR OVERLAY -->
        <Grid Panel.ZIndex="999"
      Visibility="{Binding OverlayVisible, Converter={StaticResource BoolToVis}}"
      Background="#99000000">

            <Border Width="420"
            Padding="18"
            CornerRadius="16"
            Background="#0F1521"
            BorderBrush="#2A3A52"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="{Binding OverlayText}"
           FontSize="16"
           FontWeight="SemiBold"
           Margin="0,0,0,10"
           TextWrapping="Wrap"
           TextAlignment="Center"
           MaxWidth="380">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E6EAF2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverlayIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#FF5C5C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Progress se prikazuje samo dok IsBusy -->
                    <ProgressBar Height="10" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>